    local function readServerPingMs()
        local pingMs
        pcall(function()
            local network = StatsService:FindFirstChild("Network")
            local serverStats = network and network:FindFirstChild("ServerStatsItem")
            local dataPing = serverStats and serverStats:FindFirstChild("Data Ping")
            if dataPing and dataPing.GetValue then
                pingMs = tonumber(dataPing:GetValue())
            end
        end)
        if not pingMs then
            pcall(function()
                if player.GetNetworkPing then
                    pingMs = player:GetNetworkPing() * 1000
                end
            end)
        end
        return math.clamp(tonumber(pingMs) or healSmoothPingMs or 80, 1, 2000)
    end

    local function stopHealPerfSampler()
        if healPerfConnection then
            pcall(function() healPerfConnection:Disconnect() end)
