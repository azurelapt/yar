    local function findFruitSlot()
        local list = getInventoryList()
        if not list then return nil, false end
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("GuiObject")
                and child.Name:lower():match("^%s*(.-)%s*$") == FRUIT_NAME:lower() then
                return tonumber(child.LayoutOrder), true
            end
        end
        return nil, true
    end

    local function sendOneFruit()
        remoteEvent = remoteEvent or findRemote()
        if not remoteEvent then return false, "WAITING FOR GAME REMOTE" end

        local slotId, inventoryReady = findFruitSlot()
        if not inventoryReady then return false, "WAITING FOR INVENTORY" end
        if not slotId then return false, "ADD BLOODFRUIT TO INVENTORY" end

        slotId = tonumber(slotId)
        if not slotId or slotId < 0 or slotId > 255 then
            return false, "INVALID BLOODFRUIT SLOT"
        end

        local ok = pcall(function()
            local packet = buffer.create(3)
            buffer.writeu8(packet, 0, 0)
            buffer.writeu8(packet, 1, USE_BAG_SLOT_PACKET_ID)
            buffer.writeu8(packet, 2, slotId)
            remoteEvent:FireServer(packet, nil)
        end)
        if not ok then return false, "USE ITEM SEND FAILED" end
        return true, "USING BLOODFRUIT"
    end

    local function getHumanoid()
