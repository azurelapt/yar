    outline.Thickness = 1
    outline.Transparency = 0.2
    outline.Color = Color3.fromRGB(230, 80, 80)
    outline.Parent = status

    local enabled = false
    local lastHeal = 0
    local smartHealBursting = false
    local smartHealCycleStart = 0
    local healSmoothFps = 60
    local healSmoothPingMs = 80
    local healLastPingSample = 0
    local healLagPauseUntil = 0
    local healPerfConnection = nil
    local healLastDamageTime = 0
    local healLastObservedHealth = nil
    local healNoGainStreak = 0
    local healAdaptiveDelay = 0
    local healPendingHealthCheck = nil
    local healPendingHealthAt = 0
    local remoteEvent = nil
    local itemIds = nil
    local itemModuleObject = nil
    local itemIdStatus = "WAITING FOR ITEMIDS MODULE"
