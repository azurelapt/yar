    status.AnchorPoint = Vector2.new(0.5, 0)
    status.Position = UDim2.new(0.5, 0, 0, 14)
    status.Size = UDim2.fromOffset(270, 58)
    status.BackgroundColor3 = Color3.fromRGB(22, 25, 31)
    status.BackgroundTransparency = 0.12
    status.BorderSizePixel = 0
    status.Font = Enum.Font.GothamBold
    status.Text = "AUTOHEAL OFF  [X]\nPress X to enable"
    status.AutoButtonColor = false
    status.TextColor3 = Color3.fromRGB(255, 105, 105)
    status.TextSize = 13
    status.TextWrapped = true
    status.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = status

