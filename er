    local function normalizeName(value)
        return tostring(value or ""):lower():gsub("[^%w]", "")
    end

    local function idFromValue(value)
        if typeof(value) == "Instance" and value:IsA("ValueBase") then
            value = value.Value
        end
        if type(value) == "table" then
            for _, key in ipairs({"id", "Id", "ID", "itemId", "ItemID", "itemID", "value", "Value"}) do
                local id = tonumber(value[key])
                if id and id > 0 then return id end
            end
            return nil
        end
        local id = tonumber(value)
        return id and id > 0 and id or nil
    end

    local function idFromInstance(instance)
        for _, key in ipairs({"ItemID", "itemID", "ItemId", "itemId", "ID", "Id"}) do
            local id = idFromValue(instance:GetAttribute(key))
            if id then return id end
        end
        for _, child in ipairs(instance:GetDescendants()) do
            if child:IsA("ValueBase") then
                local childName = normalizeName(child.Name)
                if childName == "itemid" or childName == "id" or childName == "item" then
                    local id = idFromValue(child.Value)
                    if id then return id end
                end
            end
        end
        return nil
    end

