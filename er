    end

    local function findFruitId()
        loadGameTables()
        if cachedFruitId then return cachedFruitId end

        -- Reuse the original source's live resolver when it is present in the
        -- same game session, then fall back to its populated name-to-ID map.
        if type(autoDiscoverItemID) == "function" then
            local ok, value = pcall(autoDiscoverItemID, FRUIT_NAME)
            if ok then cachedFruitId = idFromValue(value) end
        end
        if not cachedFruitId and type(craftNameToID) == "table" then
            cachedFruitId = idFromValue(craftNameToID[FRUIT_NAME])
        end

        if type(itemIds) == "table" then
            local direct = itemIds[FRUIT_NAME]
            cachedFruitId = cachedFruitId or idFromValue(direct)
            if not cachedFruitId then
                for id, name in pairs(itemIds) do
                    if normalizeName(name) == normalizeName(FRUIT_NAME) then
                        cachedFruitId = idFromValue(id)
                        break
                    end
                end
            end
        end
        if not cachedFruitId then
            local candidates = {}
            if itemModuleObject then
                local direct = itemModuleObject:FindFirstChild(FRUIT_NAME)
                if direct then candidates[#candidates + 1] = direct end
                for _, child in ipairs(itemModuleObject:GetDescendants()) do
                    if normalizeName(child.Name) == normalizeName(FRUIT_NAME) then
                        candidates[#candidates + 1] = child
                    end
                end
            end
            for _, candidate in ipairs(candidates) do
                cachedFruitId = idFromValue(candidate)
                    or idFromInstance(candidate)
                if cachedFruitId then break end
            end
        end

        -- Match the source's last-resort lookup: read the ID attached to the
        -- Bloodfruit inventory icon when ItemIDS does not expose a name map.
        if not cachedFruitId then
            local list = getInventoryList()
            if list then
                for _, item in ipairs(list:GetChildren()) do
                    if item:IsA("GuiObject")
                        and normalizeName(item.Name) == normalizeName(FRUIT_NAME) then
                        cachedFruitId = idFromInstance(item)
                        if not cachedFruitId then
                            for _, child in ipairs(item:GetChildren()) do
                                if child:IsA("IntValue") or child:IsA("NumberValue") then
                                    cachedFruitId = idFromValue(child.Value)
                                    if cachedFruitId then break end
                                end
                            end
                        end
                        if cachedFruitId then break end
                    end
                end
            end
        end
        if not cachedFruitId then
            cachedFruitId = findFruitIdFromCraftMenu()
        end
        if cachedFruitId then
            itemIdStatus = "BLOODFRUIT ID FOUND"
            return cachedFruitId
        end
        return nil, itemIdStatus
    end

