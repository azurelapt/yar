    local HEAL_PER_FRUIT = 3.5
    local SMARTHEAL_TRIGGER_PERCENT = 62
    local SMARTHEAL_RECOVER_PERCENT = 98
    local SMARTHEAL_CPS = 140
    local SMARTHEAL_ACTIVE_SEC = 7
    local SMARTHEAL_PAUSE_SEC = 0.30
    local TARGET_PERCENT = SMARTHEAL_RECOVER_PERCENT
    -- Mirrors Aster: CPS setting is 1-500, with SmartHeal using at least 140.
    local function getHealCPS()
        local requested = tonumber(runtime.AutoHealCPS) or 80
        local configured = math.clamp(math.floor(requested), 1, 500)
        return math.max(SMARTHEAL_CPS, configured)
    end
    local function getHealInterval(cps, adaptiveDelay)
        return math.max((1 / cps) + math.min(adaptiveDelay or 0, 0.08), 0.008)
    end
    -- Confirmed from the user's working capture: {0, 52, slot}, nil.
    local USE_BAG_SLOT_PACKET_ID = 52

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "StandaloneAutoHealStatus"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
