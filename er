    local function startHealPerfSampler()
        if healPerfConnection then return end
        healSmoothFps = 60
        healSmoothPingMs = readServerPingMs()
        healLastPingSample = 0
        healPerfConnection = RunService.Heartbeat:Connect(function(dt)
            if not enabled then return end
            if type(dt) == "number" and dt > 0 and dt < 2 then
                local instantFps = 1 / math.max(dt, 0.001)
                local alpha = (dt >= 0.1) and 0.45 or 0.15
                healSmoothFps = healSmoothFps * (1 - alpha) + instantFps * alpha
                if dt >= 0.55 then
                    local now = os.clock()
                    healLagPauseUntil = math.max(
                        healLagPauseUntil,
                        now + math.clamp(dt * 0.25, 0.08, 0.22)
                    )
                end
            end
            local now = os.clock()
            if now - healLastPingSample >= 0.25 then
                healLastPingSample = now
                healSmoothPingMs = healSmoothPingMs * 0.7 + readServerPingMs() * 0.3
            end
        end)
        if type(runtime.__StandaloneAutoHeal) == "table" then
            runtime.__StandaloneAutoHeal.perfConnection = healPerfConnection
        end
    end

    local function getPingFpsHealScale(hpPercent, recentlyDamaged)
        local fps = healSmoothFps
        local ping = healSmoothPingMs
        local critical = (hpPercent or 100) <= 45
        local underPressure = critical or recentlyDamaged or (enabled and smartHealBursting)

        local fpsScale
        if fps < 8 then
            fpsScale = underPressure and 0.55 or 0.4
        elseif fps < 15 then
            fpsScale = underPressure and 0.7 or (0.55 + (fps - 8) / 7 * 0.2)
        elseif fps < 25 then
            fpsScale = 0.75 + (fps - 15) / 10 * 0.15
        elseif fps < 40 then
            fpsScale = 0.9 + (fps - 25) / 15 * 0.08
        else
            fpsScale = 1
        end

        local pingScale
        if ping <= 90 then
            pingScale = 1
        elseif ping <= 140 then
            pingScale = 1 - (ping - 90) / 50 * 0.12
        elseif ping <= 200 then
            pingScale = 0.88 - (ping - 140) / 60 * 0.15
        elseif ping <= 300 then
            pingScale = 0.73 - (ping - 200) / 100 * 0.15
        elseif ping <= 450 then
            pingScale = 0.58 - (ping - 300) / 150 * 0.13
        else
            pingScale = underPressure and 0.45 or 0.35
        end

        local floor = underPressure and 0.45 or 0.32
        return math.clamp(math.min(fpsScale, pingScale), floor, 1)
    end

    local function getEffectiveHealCPS(hpPercent, recentlyDamaged)
        local now = os.clock()
        local lagPaused = now < healLagPauseUntil
        local scale = getPingFpsHealScale(hpPercent, recentlyDamaged)
        local base = getHealCPS()

        local gainScale = 1
        if not recentlyDamaged then
            if healNoGainStreak >= 8 then
                gainScale = 0.45
            elseif healNoGainStreak >= 5 then
                gainScale = 0.65
            elseif healNoGainStreak >= 3 then
                gainScale = 0.85
            end
        end

        local cps = base * scale * gainScale
        if lagPaused and not recentlyDamaged and hpPercent > 45 then
            cps = math.min(cps, math.max(14, base * 0.35))
        end

        local survivalFloor = 14
        if hpPercent <= 30 then
            survivalFloor = 28
        elseif hpPercent <= 45 then
            survivalFloor = 22
        elseif recentlyDamaged or smartHealBursting then
            survivalFloor = 18
        end
        if cps < survivalFloor then cps = survivalFloor end
        return math.clamp(cps, survivalFloor, base)
    end

    local function getSmartHealDutyCycle(now)
        now = now or os.clock()
        if smartHealCycleStart <= 0 then smartHealCycleStart = now end
        local period = SMARTHEAL_ACTIVE_SEC + SMARTHEAL_PAUSE_SEC
        local elapsed = (now - smartHealCycleStart) % period
        if elapsed < SMARTHEAL_ACTIVE_SEC then
            return true, SMARTHEAL_ACTIVE_SEC - elapsed
        end
        return false, period - elapsed
    end

    local function isGodPlayerCharacter(character)
        if not character then return false end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.MaxHealth > 1000 then return true end
        for _, pieceName in ipairs(GOD_ARMOR_PIECES) do
            if character:FindFirstChild(pieceName) then return true end
        end
        return false
    end

    local function getGodArmorCount(character)
        local count = 0
        for _, pieceName in ipairs(GOD_ARMOR_PIECES) do
            if character and character:FindFirstChild(pieceName) then
                count = count + 1
            end
        end
        return count
    end

    local function destroyGodPlayerEspEntry(data)
        if not data then return end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
    end

    local function clearGodEspObjects()
        for target, data in pairs(godEspObjects) do
            destroyGodPlayerEspEntry(data)
            godEspObjects[target] = nil
        end
    end

    local function stopGodEsp()
        godEspEnabled = false
        godEspGeneration = godEspGeneration + 1
        clearGodEspObjects()
        godEspToggleButton.Text = "GOD ESP: OFF"
        godEspToggleButton.BackgroundColor3 = Color3.fromRGB(35, 42, 54)
    end

    local function makeGodPlayerEspEntry(target, character, rootPart, adornee, distance)
        local color = Color3.fromRGB(255, 235, 85)
        local highlight = Instance.new("Highlight")
        highlight.Name = "GodPlayerESPHighlight"
        highlight.Adornee = character
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Parent = character

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "GodPlayerESP"
        billboard.Adornee = adornee
        billboard.Size = UDim2.fromOffset(200, 36)
        billboard.StudsOffset = Vector3.new(0, 5, 0)
        billboard.AlwaysOnTop = true
        billboard.LightInfluence = 0
        billboard.MaxDistance = 0
        billboard.Parent = character

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextColor3 = color
        label.TextStrokeTransparency = 1
        label.TextSize = 12
        label.Text = string.format("%s GOD [%d] [%d/3]", target.Name, math.floor(distance), getGodArmorCount(character))
        label.Parent = billboard

        local textStroke = Instance.new("UIStroke")
        textStroke.Thickness = 0.75
        textStroke.Transparency = 0
        textStroke.Color = Color3.new(0, 0, 0)
        textStroke.Parent = label

        return {
            character = character,
            rootPart = rootPart,
            adornee = adornee,
            highlight = highlight,
            billboard = billboard,
            label = label,
        }
    end

    local function setGodEspEnabled(value)
        value = value == true
        if godEspEnabled == value then return end
        godEspEnabled = value
        godEspGeneration = godEspGeneration + 1
        local generation = godEspGeneration
        godEspToggleButton.Text = godEspEnabled and "GOD ESP: ON" or "GOD ESP: OFF"
        godEspToggleButton.BackgroundColor3 = godEspEnabled
            and Color3.fromRGB(78, 68, 36)
            or Color3.fromRGB(35, 42, 54)

        if not godEspEnabled then
            clearGodEspObjects()
            return
        end

        task.spawn(function()
            while screenGui.Parent and godEspEnabled and generation == godEspGeneration do
                local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if localRoot then
                    local currentPlayers = {}
                    for _, target in ipairs(Players:GetPlayers()) do
                        if target ~= player then
                            local character = target.Character
                            if character and character.Parent and isGodPlayerCharacter(character) then
                                local rootPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
                                local adornee = character:FindFirstChild("Head") or rootPart
                                if rootPart and adornee then
                                    currentPlayers[target] = true
                                    local distance = (rootPart.Position - localRoot.Position).Magnitude
                                    local data = godEspObjects[target]
                                    if not data or data.character ~= character
                                        or data.rootPart ~= rootPart or data.adornee ~= adornee
                                        or not data.billboard.Parent or not data.highlight.Parent then
                                        destroyGodPlayerEspEntry(data)
                                        data = makeGodPlayerEspEntry(target, character, rootPart, adornee, distance)
                                        godEspObjects[target] = data
                                    end
                                    data.label.Text = string.format(
                                        "%s GOD [%d] [%d/3]",
                                        target.Name,
                                        math.floor(distance),
                                        getGodArmorCount(character)
                                    )
                                end
                            end
                        end
                    end

                    for target, data in pairs(godEspObjects) do
                        if not target.Parent or not currentPlayers[target] then
                            destroyGodPlayerEspEntry(data)
                            godEspObjects[target] = nil
                        end
                    end
                end
                task.wait(0.1)
            end
            if generation == godEspGeneration then clearGodEspObjects() end
        end)
    end

    local function saveAndSet(instance, property, value)
        local saved = performanceOriginals[instance]
        if not saved then
            saved = {}
            performanceOriginals[instance] = saved
        end
        if saved[property] == nil then
            local ok, original = pcall(function() return instance[property] end)
            if ok then saved[property] = original end
        end
        pcall(function() instance[property] = value end)
    end

    local function applyPerformanceToInstance(instance)
        if not performanceEnabled then return end
        if instance:IsA("BasePart") then
            saveAndSet(instance, "CastShadow", false)
            saveAndSet(instance, "Material", Enum.Material.SmoothPlastic)
            saveAndSet(instance, "Reflectance", 0)
        elseif instance:IsA("Decal") or instance:IsA("Texture") then
            saveAndSet(instance, "Transparency", 1)
        elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail")
            or instance:IsA("Beam") or instance:IsA("Fire")
            or instance:IsA("Smoke") or instance:IsA("Sparkles") then
            saveAndSet(instance, "Enabled", false)
        elseif instance:IsA("PostEffect") then
            saveAndSet(instance, "Enabled", false)
        elseif instance:IsA("Clouds") then
            saveAndSet(instance, "Enabled", false)
        elseif instance:IsA("Atmosphere") then
            saveAndSet(instance, "Density", 0)
            saveAndSet(instance, "Haze", 0)
            saveAndSet(instance, "Glare", 0)
        elseif instance:IsA("SurfaceAppearance") then
            saveAndSet(instance, "ColorMap", "")
            saveAndSet(instance, "NormalMap", "")
            saveAndSet(instance, "MetalnessMap", "")
            saveAndSet(instance, "RoughnessMap", "")
        end
    end

    local function restorePerformanceMode()
        for _, addedConnection in ipairs(performanceAddedConnections) do
            pcall(function() addedConnection:Disconnect() end)
        end
        table.clear(performanceAddedConnections)
        for instance, properties in pairs(performanceOriginals) do
            for property, original in pairs(properties) do
                pcall(function() instance[property] = original end)
            end
            performanceOriginals[instance] = nil
        end
    end

    local function stopPerformanceMode()
        performanceEnabled = false
        restorePerformanceMode()
        performanceToggleButton.Text = "POTATO: OFF"
        performanceToggleButton.BackgroundColor3 = Color3.fromRGB(35, 42, 54)
    end

    local function setPerformanceMode(value)
        value = value == true
        if performanceEnabled == value then return end
        performanceEnabled = value
        performanceToggleButton.Text = performanceEnabled and "POTATO: ON" or "POTATO: OFF"
        performanceToggleButton.BackgroundColor3 = performanceEnabled
            and Color3.fromRGB(61, 55, 86)
            or Color3.fromRGB(35, 42, 54)

        if not performanceEnabled then
            restorePerformanceMode()
            return
        end

        local lighting = game:GetService("Lighting")
        saveAndSet(lighting, "GlobalShadows", false)
        saveAndSet(lighting, "EnvironmentDiffuseScale", 0)
        saveAndSet(lighting, "EnvironmentSpecularScale", 0)
        saveAndSet(lighting, "FogEnd", 1000000000)

        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            saveAndSet(terrain, "Decoration", false)
            saveAndSet(terrain, "WaterWaveSize", 0)
            saveAndSet(terrain, "WaterWaveSpeed", 0)
            saveAndSet(terrain, "WaterReflectance", 0)
            saveAndSet(terrain, "WaterTransparency", 0.75)
        end

        for _, instance in ipairs(workspace:GetDescendants()) do
            applyPerformanceToInstance(instance)
        end
        for _, instance in ipairs(lighting:GetDescendants()) do
            applyPerformanceToInstance(instance)
        end
        performanceAddedConnections[#performanceAddedConnections + 1] = workspace.DescendantAdded:Connect(function(instance)
            if performanceEnabled then applyPerformanceToInstance(instance) end
        end)
        performanceAddedConnections[#performanceAddedConnections + 1] = lighting.DescendantAdded:Connect(function(instance)
            if performanceEnabled then applyPerformanceToInstance(instance) end
        end)
    end

    local function toggleAutoHeal()
        enabled = not enabled
        lastHeal = 0
        smartHealBursting = false
        smartHealCycleStart = 0
        healLastDamageTime = 0
        healLastObservedHealth = nil
        healNoGainStreak = 0
        healAdaptiveDelay = 0
        healPendingHealthCheck = nil
        healPendingHealthAt = 0
        healLagPauseUntil = 0
        if enabled then
            local humanoid = getHumanoid()
            healLastObservedHealth = humanoid and humanoid.Health or nil
            startHealPerfSampler()
        else
            stopHealPerfSampler()
        end
    end

    local function beginKeybindCapture()
        waitingForKey = true
        lastDisplay = nil
        keybindButton.Text = "PRESS KEY"
        keybindHint.Text = "Press key • ESC cancels"
        statusLabel.Text = "SET HEAL KEYBIND\nPress a key • Esc cancels"
        statusLabel.TextColor3 = Color3.fromRGB(247, 229, 191)
        outline.Color = Color3.fromRGB(245, 181, 80)
    end

    local healButtonConnection = healToggleButton.Activated:Connect(toggleAutoHeal)
    local godClickConnection = godEspToggleButton.Activated:Connect(function()
        setGodEspEnabled(not godEspEnabled)
    end)
    local performanceClickConnection = performanceToggleButton.Activated:Connect(function()
        setPerformanceMode(not performanceEnabled)
    end)
    local keybindClickConnection = keybindButton.Activated:Connect(beginKeybindCapture)

    local connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if waitingForKey then
            if input.KeyCode == Enum.KeyCode.Escape then
                waitingForKey = false
                lastDisplay = nil
                return
            end
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                healKeyCode = input.KeyCode
                runtime.AutoHealKey = healKeyCode.Name
                waitingForKey = false
                lastDisplay = nil
                keybindButton.Text = "KEY: " .. healKeyCode.Name
                keybindHint.Text = "Click KEY to rebind"
            end
            return
        end

        if gameProcessed then return end
        if input.KeyCode == healKeyCode then
            toggleAutoHeal()
            lastDisplay = nil
        end
    end)

    runtime.__StandaloneAutoHeal = {
        connection = connection,
        clickConnection = healButtonConnection,
        godClickConnection = godClickConnection,
        performanceClickConnection = performanceClickConnection,
        keybindClickConnection = keybindClickConnection,
        perfConnection = healPerfConnection,
        godEspStop = stopGodEsp,
        performanceStop = stopPerformanceMode,
        gui = screenGui,
    }

    task.spawn(function()
        while screenGui.Parent do
            if not enabled then
                show("SMARTHEAL OFF • PRESS " .. healKeyCode.Name, false, false)
                task.wait(0.12)
            else
                local now = os.clock()
                local humanoid = getHumanoid()
                if not humanoid then
                    smartHealBursting = false
                    smartHealCycleStart = 0
                    show("WAITING FOR CHARACTER", true, false)
                    task.wait(0.12)
                elseif humanoid.Health <= 0 or humanoid.MaxHealth <= 0 then
                    smartHealBursting = false
                    smartHealCycleStart = 0
                    healPendingHealthCheck = nil
                    healPendingHealthAt = 0
                    show("WAITING FOR RESPAWN", true, false)
                    task.wait(0.12)
                else
                    local health = humanoid.Health
                    local hpPercent = (health / humanoid.MaxHealth) * 100
                    if healLastObservedHealth ~= nil then
                        if health < healLastObservedHealth - 0.01 then
                            healLastDamageTime = now
                            healNoGainStreak = 0
                            healAdaptiveDelay = math.max(0, healAdaptiveDelay * 0.45)
                        elseif health > healLastObservedHealth + 0.75 then
                            healNoGainStreak = 0
                            healAdaptiveDelay = math.max(0, healAdaptiveDelay - 0.012)
                        end
                    end
                    healLastObservedHealth = health
                    local recentlyDamaged = (now - healLastDamageTime) < 1.25
                    local hint = getHealthState()

                    if hpPercent >= SMARTHEAL_RECOVER_PERCENT then
                        smartHealBursting = false
                        smartHealCycleStart = 0
                        healPendingHealthCheck = nil
                        healPendingHealthAt = 0
                        healNoGainStreak = 0
                        healAdaptiveDelay = 0
                        show(hint, true, true)
                        task.wait(0.08)
                    elseif not smartHealBursting and hpPercent > SMARTHEAL_TRIGGER_PERCENT then
                        show(("HP %.0f/%.0f • SMARTHEAL ARMED AT %d%%"):format(
                            health, humanoid.MaxHealth, SMARTHEAL_TRIGGER_PERCENT
                        ), true, false)
                        task.wait(0.08)
                    else
                        if not smartHealBursting then
                            smartHealBursting = true
                            smartHealCycleStart = now
                        end

                        local waitForHealth = math.clamp(
                            (healSmoothPingMs or 80) / 1000 * 1.15, 0.08, 0.35
                        )
                        if healPendingHealthCheck ~= nil
                            and now - healPendingHealthAt >= waitForHealth then
                            if health <= healPendingHealthCheck + 0.01 then
                                if not recentlyDamaged then
                                    healNoGainStreak = healNoGainStreak + 1
                                    if healNoGainStreak >= 4 then
                                        healAdaptiveDelay = math.min(0.12, healAdaptiveDelay + 0.008)
                                    end
                                end
                            else
                                healNoGainStreak = 0
                                healAdaptiveDelay = math.max(0, healAdaptiveDelay - 0.02)
                            end
                            healPendingHealthCheck = nil
                            healPendingHealthAt = 0
                        end

                        local critical = hpPercent <= 45
                        if now < healLagPauseUntil and not critical and not recentlyDamaged then
                            show(hint .. " • NETWORK PAUSE", true, false)
                            task.wait(math.max(0.05, math.min(0.12, healLagPauseUntil - now)))
                        else
                            local cycleActive, phaseLeft = getSmartHealDutyCycle(now)
                            if not cycleActive then
                                healPendingHealthCheck = nil
                                healPendingHealthAt = 0
                                show(("SMARTHEAL PAUSE • HP %.0f%%"):format(hpPercent), true, false)
                                task.wait(math.clamp(phaseLeft, 0.05, 0.25))
                            else
                                if healPendingHealthCheck == nil then
                                    healPendingHealthCheck = health
                                    healPendingHealthAt = now
                                end
                                local healCPS = getEffectiveHealCPS(hpPercent, recentlyDamaged)
                                local healInterval = getHealInterval(healCPS, healAdaptiveDelay)
                                local waitRemaining = healInterval - (now - lastHeal)
                                if waitRemaining > 0 then
                                    show(hint .. " • SMARTHEAL " .. math.floor(healCPS) .. " CPS", true, false)
                                    task.wait(waitRemaining)
                                else
                                    local ok, result = sendOneFruit()
                                    if ok then
                                        lastHeal = os.clock()
                                        show(hint .. " • SMARTHEAL " .. math.floor(healCPS) .. " CPS", true, true)
                                        task.wait(healInterval)
                                    else
                                        show(result, true, false)
                                        task.wait(0.08)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end
