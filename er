    local function findRemote()
        local direct = ReplicatedStorage:FindFirstChild("ByteNetReliable")
        if direct and direct:IsA("RemoteEvent") then return direct end
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj.Name == "ByteNetReliable" and obj:IsA("RemoteEvent") then
                return obj
            end
        end
        return nil
    end

    local function loadGameTables()
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        if not itemModuleObject and os.clock() - lastItemModuleScan >= 2 then
            lastItemModuleScan = os.clock()
            local wantedNames = {
                itemids = true,
                itemid = true,
                itemidmap = true,
                itemidtable = true,
            }
            local function matchesItemIdModule(instance)
                local normalized = instance.Name:lower():gsub("[^%w]", "")
                return wantedNames[normalized] == true
            end
            if modules then
                for _, child in ipairs(modules:GetChildren()) do
                    if matchesItemIdModule(child) then
                        itemModuleObject = child
                        break
                    end
                end
            end
            if not itemModuleObject then
                for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
                    if matchesItemIdModule(descendant) then
                        itemModuleObject = descendant
                        break
                    end
                end
            end
        end

        if itemModuleObject and not itemIds and itemModuleObject:IsA("ModuleScript") then
            local ok, result = pcall(require, itemModuleObject)
            if ok and type(result) == "table" then
                itemIds = result
                itemIdStatus = "ITEMIDS LOADED; BLOODFRUIT ENTRY MISSING"
            elseif not ok then
                itemIdStatus = "ITEMIDS MODULE COULD NOT LOAD"
            end
        elseif not itemModuleObject then
            itemIdStatus = "ITEMIDS MODULE NOT FOUND"
        elseif not itemIds then
            itemIdStatus = "ITEMIDS CONTAINER FOUND; LOOKING FOR BLOODFRUIT"
        end

        if not modules then return end

        local packetsModule = modules:FindFirstChild("Packets")
        if packetsModule and not packets then
            local ok, result = pcall(require, packetsModule)
            if ok and type(result) == "table" then packets = result end
        end

        if not packetIdTable then
            local candidates = {}
            local function addCandidate(candidate)
                if candidate then candidates[#candidates + 1] = candidate end
            end
            local byteNet = modules:FindFirstChild("ByteNet")
            local packetFolder = byteNet and byteNet:FindFirstChild("packets")
            if packetFolder then
                addCandidate(packetFolder:FindFirstChild("packetIDs"))
                addCandidate(packetFolder:FindFirstChild("packetIds"))
                addCandidate(packetFolder:FindFirstChild("PacketIDs"))
            end
            if byteNet then
                addCandidate(byteNet:FindFirstChild("packetIDs"))
                addCandidate(byteNet:FindFirstChild("packetIds"))
            end
            addCandidate(modules:FindFirstChild("packetIDs"))
            addCandidate(modules:FindFirstChild("packetIds"))
            for _, descendant in ipairs(modules:GetDescendants()) do
                local lowerName = descendant.Name:lower()
                if descendant:IsA("ModuleScript")
                    and lowerName:find("packet", 1, true)
                    and lowerName:find("id", 1, true) then
                    addCandidate(descendant)
                end
            end
            for _, candidate in ipairs(candidates) do
                if candidate then
                    local ok, result = pcall(require, candidate)
                    if ok and type(result) == "table" then
                        packetIdTable = result
                        break
                    end
                end
            end
        end
    end

    local function xorString(value, key)
        if type(value) ~= "string" or type(bit32) ~= "table" then return nil end
        local output = table.create(#value)
        for i = 1, #value do
            local keyByte = string.byte(key, ((i - 1) % #key) + 1)
            output[i] = string.char(bit32.bxor(string.byte(value, i), keyByte))
        end
        return table.concat(output)
    end

    local function readCachedPacketId(packetName)
        if type(readfile) ~= "function" then return nil end
        local paths = {
            "ASTER/sys/c7/f2a91b.dat",
            "ASTER/Booga/packet_ids.json",
        }
        for _, path in ipairs(paths) do
            local ok, raw = pcall(readfile, path)
            if ok and type(raw) == "string" and raw ~= "" then
                local json = raw
                if raw:sub(1, 4) == "AX1:" then
                    local decodedOk, decoded = pcall(function()
                        return HttpService:Base64Decode(raw:sub(5))
                    end)
                    if decodedOk then
                        json = xorString(decoded, "A$t3rPk7_v2") or ""
                    else
                        json = ""
                    end
                elseif raw:sub(1, 4) == "AX0:" then
                    json = xorString(raw:sub(5), "A$t3rPk7_v2") or ""
                elseif raw:sub(1, 1) ~= "{" then
                    json = ""
                end

                if json ~= "" then
                    local decodedOk, decoded = pcall(function()
                        return HttpService:JSONDecode(json)
                    end)
                    if decodedOk and type(decoded) == "table" then
                        local packetMap = type(decoded.packets) == "table"
                            and decoded.packets or decoded
                        local id = tonumber(packetMap[packetName])
                        if id and id > 0 then return id end
                    end
                end
            end
        end
        return nil
    end

    local function findPacketId(packetName)
        if type(getPacketId) == "function" then
            local ok, id = pcall(getPacketId, packetName)
            if ok and tonumber(id) then return tonumber(id) end
        end
        if type(PACKET_IDS) == "table" then
            local sharedId = tonumber(PACKET_IDS[packetName])
            if sharedId and sharedId > 0 then return sharedId end
        end
        loadGameTables()
        local packet = packets and packets[packetName]
        if type(packet) == "table" then
            for _, key in ipairs({"id", "Id", "_id", "packetId", "packetID", "ID"}) do
                local id = tonumber(packet[key])
                if id and id > 0 then return id end
            end
        end
        if type(packetIdTable) == "table" and packet then
            for id, registeredPacket in pairs(packetIdTable) do
                if registeredPacket == packet and tonumber(id) then
                    return tonumber(id)
                end
            end
        end
        return readCachedPacketId(packetName)
    end

